---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const projects = await getCollection('projects');
const completedProjects = projects.filter(p => p.data.status === 'completed');
const wipProjects = projects.filter(p => p.data.status === 'wip');

const categories = [...new Set(completedProjects.map(p => p.data.category))];
---

<Layout title="Works | Nicolas Genty">
	<Header />
	
	<main class="pt-32">
		<div class="max-w-[1440px] mx-auto px-8 pb-32">
			{categories.map((category) => (
				<section class="mb-32">
					<header class="mb-24 border-b border-outline-variant pb-4">
						<h2 class="font-mono text-[0.6875rem] tracking-widest uppercase opacity-40">
							( {category} )
						</h2>
					</header>
					
					<div class="space-y-32">
						{completedProjects
							.filter(p => p.data.category === category)
							.map(project => (
								<ProjectCard project={project} />
							))
						}
					</div>
				</section>
			))}

			{wipProjects.length > 0 && (
				<section class="mt-48">
					<header class="mb-16 border-b border-outline-variant pb-4">
						<h2 class="font-mono text-[0.6875rem] tracking-widest uppercase opacity-40">
							( work in progress )
						</h2>
					</header>
					
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
						{wipProjects.map(project => (
							<div class="group border border-outline-variant p-6 hover:bg-surface-container-low transition-colors duration-300 rounded-tag">
								<div class="aspect-video bg-surface-container mb-6 overflow-hidden border border-outline-variant/30 rounded-sm">
									<Image 
										src={project.data.images[0]} 
										alt={project.data.title}
										width={800}
										height={450}
										class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" 
									/>
								</div>
								<h3 class="text-xl font-bold uppercase mb-3 font-headline group-hover:text-primary transition-colors">
									{project.data.title}
								</h3>
								<p class="font-mono text-sm opacity-60 leading-relaxed">
									{project.data.description}
								</p>
								<div class="mt-6 flex flex-wrap gap-2">
									{project.data.tech.slice(0, 3).map(t => (
										<span class="text-[10px] font-mono uppercase bg-outline-variant text-on-surface px-2 py-1 rounded-tag">
											#{t.name}
										</span>
									))}
								</div>
							</div>
						))}
					</div>
				</section>
			)}
		</div>
	</main>

	<Footer />
</Layout>
