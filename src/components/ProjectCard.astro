---
import Gallery from './Gallery.tsx';

const { project } = Astro.props;

const getIconSlug = (name: string) => name.toLowerCase().replace(' ', '');
---

<div class="flex flex-col md:flex-row gap-12 items-start mb-48">
  {/* Project Info */}
  <div class="w-full md:w-1/3 flex flex-col gap-4 md:sticky md:top-32">
    <div class="flex items-baseline gap-4">
      <h3 class="text-3xl font-bold tracking-tighter uppercase font-headline">
        {project.data.title}
      </h3>
    </div>
    <div class="space-y-4 max-w-sm">
      <p class="text-[0.875rem] leading-relaxed opacity-70 font-mono">
        {project.data.description}
      </p>
      
      <div class="flex flex-wrap gap-2 pt-4">
        {project.data.tech.map((t) => (
          <span class="font-mono text-[0.6875rem] px-3 py-1 bg-outline-variant text-on-surface flex items-center gap-2 tracking-widest uppercase rounded-tag">
            <div 
              class="w-3 h-3 bg-primary icon-mask" 
              style={`-webkit-mask-image: url(https://cdn.simpleicons.org/${getIconSlug(t.icon)}/white); mask-image: url(https://cdn.simpleicons.org/${getIconSlug(t.icon)}/white);`}
            />
            {t.name}
          </span>
        ))}
      </div>
      
      <div class="flex gap-6 pt-8">
        {project.data.links.map((link) => (
          <a 
            href={link.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 text-primary font-mono text-xs font-bold tracking-widest uppercase hover:translate-x-2 transition-transform"
          >
            <div 
              class="w-4 h-4 bg-primary icon-mask" 
              style={`-webkit-mask-image: url(https://cdn.simpleicons.org/${link.icon === 'world' ? 'googlechrome' : getIconSlug(link.icon)}/white); mask-image: url(https://cdn.simpleicons.org/${link.icon === 'world' ? 'googlechrome' : getIconSlug(link.icon)}/white);`}
            />
            {link.type === 'site' ? 'www' : 'github'}
          </a>
        ))}
      </div>
    </div>
  </div>

  {/* Sliding Gallery */}
  <div class="w-full md:w-2/3">
    <Gallery client:visible images={project.data.images} title={project.data.title} />
  </div>
</div>
