---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import profileImage from '../assets/profil.jpg';

const profile = await getEntry('user', 'profile');
const { name, profession, bio, socials } = profile.data;

const getIconUrl = (socialName: string) =>
  `/icons/${socialName.toLowerCase().replace(/\s+/g, '')}.svg`;
---

<Layout title="About | Nicolas Genty">
  <Header />

  <main class="pt-32">
    <section
      id="about"
      class="mx-auto flex max-w-[1440px] flex-col items-center px-8 pb-24 pt-24 text-center"
    >
      <div class="relative mb-12">
        <div
          class="h-40 w-40 overflow-hidden rounded-full border border-outline-variant grayscale transition-all duration-500 hover:grayscale-0"
        >
          <Image
            src={profileImage}
            alt={name}
            loading="eager"
            width={400}
            height={400}
            quality={85}
            format="webp"
            class="h-full w-full scale-110 object-cover"
          />
        </div>
      </div>
      <h1
        class="mb-6 font-headline text-6xl font-bold uppercase leading-none tracking-tighter md:text-8xl"
      >
        {name.toUpperCase()}
      </h1>
      <p
        class="mb-12 max-w-2xl font-mono text-sm uppercase leading-relaxed tracking-widest opacity-60"
      >
        {profession} / {bio}
      </p>

      <div class="flex w-full max-w-xs flex-col gap-4">
        {
          socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between rounded-tag border border-outline-variant bg-surface-container-low px-6 py-4 transition-all duration-300 hover:border-primary hover:bg-primary"
            >
              <span class="flex items-center gap-3 font-mono text-sm uppercase tracking-widest group-hover:text-on-primary">
                <div
                  class="icon-mask h-5 w-5 bg-on-surface transition-colors group-hover:bg-on-primary"
                  style={`-webkit-mask-image: url(${getIconUrl(social.name)}); mask-image: url(${getIconUrl(social.name)});`}
                />
                {social.name}
              </span>
              <div
                class="icon-mask h-5 w-5 bg-on-surface transition-colors group-hover:bg-on-primary"
                style="-webkit-mask-image: url(/icons/arrow-up-right.svg); mask-image: url(/icons/arrow-up-right.svg);"
              />
            </a>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
