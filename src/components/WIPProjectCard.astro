---
import { Image } from 'astro:assets';

const { project } = Astro.props;

const getIconSlug = (name: string) => name.toLowerCase().replace(/\s+/g, '');
---

<div class="group p-6 hover:bg-surface-container-low transition-colors duration-300 flex flex-col h-full">
  <div class="aspect-video bg-surface-container mb-6 overflow-hidden border border-outline-variant/30 rounded-sm">
    <Image 
      src={project.data.images[0]} 
      alt={project.data.title}
      width={800}
      height={450}
      quality={85}
      format="webp"
      class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" 
    />
  </div>
  <h3 class="text-xl font-bold uppercase mb-3 font-headline group-hover:text-primary transition-colors">
    {project.data.title}
  </h3>
  <p class="font-mono text-sm opacity-60 leading-relaxed flex-grow">
    {project.data.description}
  </p>
  <div class="mt-8 flex flex-wrap gap-2">
    {project.data.tech.map((t) => (
      <span class="text-[10px] font-mono uppercase bg-outline-variant text-on-surface px-2 py-1 rounded-tag flex items-center gap-2">
        <div 
          class="w-4 h-4 bg-primary icon-mask" 
          style={`-webkit-mask-image: url(/icons/${getIconSlug(t.icon)}.svg); mask-image: url(/icons/${getIconSlug(t.icon)}.svg);`}
        />
        {t.name}
      </span>
    ))}
  </div>
</div>
